# Copy this file to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000

# Manus OAuth / session
VITE_APP_ID=your_manus_app_id
JWT_SECRET=replace_with_a_long_random_local_secret
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://oauth.manus.im
OWNER_OPEN_ID=your_owner_open_id
OWNER_NAME=Your Name

# Managed database (MySQL/TiDB)
DATABASE_URL=mysql://user:password@host:4000/database?ssl={"rejectUnauthorized":true}

# Manus built-in integrations (optional AI, storage, maps, notifications, and voice)
BUILT_IN_FORGE_API_URL=https://forge.manus.ai
BUILT_IN_FORGE_API_KEY=your_server_side_forge_api_key
VITE_FRONTEND_FORGE_API_URL=https://forge.manus.ai
VITE_FRONTEND_FORGE_API_KEY=your_frontend_forge_api_key

# Optional direct OpenAI-compatible integration
OPENAI_API_KEY=your_openai_api_key

# Optional analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
